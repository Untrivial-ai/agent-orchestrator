AO_CLOUD_ENV=development
AO_CLOUD_RELEASE=dev
AO_CLOUD_HTTP_ADDRESS=127.0.0.1:8080
AO_CLOUD_DATABASE_URL=postgres://localhost/ao_cloud?sslmode=disable
# Optional elevated migration credential; defaults to AO_CLOUD_DATABASE_URL.
AO_CLOUD_MIGRATION_DATABASE_URL=
# Defaults to true for development/test and false for staging/production.
AO_CLOUD_MIGRATE_ON_STARTUP=
# Bounds migration lock waits and DDL execution.
AO_CLOUD_MIGRATION_TIMEOUT=15m
# Optional role that receives runtime grants after each hosted migration.
AO_CLOUD_RUNTIME_DATABASE_USER=

# Production authentication. Set all three together. The WorkOS API base URL
# is expanded to the client-specific AuthKit token issuer at startup.
AO_CLOUD_WORKOS_ISSUER=
AO_CLOUD_WORKOS_CLIENT_ID=
AO_CLOUD_WORKOS_API_KEY=
# Optional override. Defaults to the WorkOS or custom AuthKit-domain JWKS URL.
AO_CLOUD_WORKOS_JWKS_URL=

# Development only. Enable explicitly when running without WorkOS.
AO_CLOUD_LOCAL_AUTH=false
AO_CLOUD_LOCAL_SESSION_TTL=24h

# Sandbox provider: ecs | daytona | docker | nodeops. Must be nodeops in
# staging and production.
AO_CLOUD_SANDBOX_PROVIDER=ecs
# AES-256 key for provider credentials, encoded as base64. Required when hosted;
# local launch scripts generate and persist one under AO_DATA_DIR.
AO_CLOUD_PROVIDER_SECRET_KEY=

# NodeOps CreateOS sandbox provider (AO_CLOUD_SANDBOX_PROVIDER=nodeops).
# ONE account/key serves every customer; it is read only here in the control
# plane and never reaches a browser or a sandbox. Free tier caps at 1 concurrent
# sandbox and shape s-1vcpu-1gb.
#
# Free -> paid is exactly two changes, no code: swap the API key and raise the
# default shape (e.g. s-2vcpu-4gb or s-4vcpu-8gb). Everything else stays.
AO_CLOUD_NODEOPS_BASE_URL=https://api.sb.createos.sh
AO_CLOUD_NODEOPS_API_KEY=
AO_CLOUD_NODEOPS_DEFAULT_SHAPE=s-1vcpu-1gb
AO_CLOUD_NODEOPS_DEFAULT_ROOTFS=devbox:1
# Provider-side idle auto-pause: seconds of inactivity before CreateOS pauses
# the sandbox itself. Disabled by default (0) and normally should stay that
# way: CreateOS only resets this timer on an `exec` call, and the worker sends
# exactly one, at boot, so the timer cannot distinguish a working agent from
# an abandoned one and can pause mid-turn. The control plane's own idle-pause
# scanner (AO_CLOUD_IDLE_PAUSE_THRESHOLD below) is what actually understands
# session activity; only set this if you specifically want a redundant
# provider-side timer on top of it.
AO_CLOUD_NODEOPS_AUTO_PAUSE_SECONDS=0
AO_CLOUD_NODEOPS_INGRESS=
AO_CLOUD_NODEOPS_SSH_KEY_PATH=
AO_CLOUD_NODEOPS_REGION=
AO_CLOUD_NODEOPS_WORKER_TOKEN_TTL=

# Control-plane idle pause: pauses a session's sandbox once the user has sent
# no message and the agent has no turn in flight for this long. State is
# preserved; a new user message resumes it. 0 is rejected — use
# AO_CLOUD_NODEOPS_AUTO_PAUSE_SECONDS=0 to disable idling entirely instead.
AO_CLOUD_IDLE_PAUSE_THRESHOLD=1h
# How often the idle-pause scanner looks for sessions to pause.
AO_CLOUD_IDLE_PAUSE_INTERVAL=30s

# Optional GitHub App integration. Set every value together. The private key is
# the PEM downloaded for the App; STATE_KEY is 32 random bytes encoded as base64.
AO_CLOUD_GITHUB_APP_ID=
AO_CLOUD_GITHUB_APP_SLUG=
AO_CLOUD_GITHUB_CLIENT_ID=
AO_CLOUD_GITHUB_CLIENT_SECRET=
AO_CLOUD_GITHUB_PRIVATE_KEY=
AO_CLOUD_GITHUB_WEBHOOK_SECRET=
AO_CLOUD_GITHUB_STATE_KEY=
AO_CLOUD_GITHUB_INSTALL_TTL=10m
AO_CLOUD_GITHUB_WEBHOOK_MAX_BYTES=2097152
AO_CLOUD_PUBLIC_URL=
# Shared only by production and authenticated environment control planes.
# Use at least 32 random characters; never expose either token to browser JS.
AO_CLOUD_REPOSITORY_BROKER_URL=https://api.aoagents.dev
AO_CLOUD_REPOSITORY_BROKER_TOKEN=
AO_CLOUD_ENV_CONTROL_TOKEN=

# Optional overrides used only by `npm run cloud:staging`. The command defaults
# to staging-api.aoagents.dev and the checked-in non-secret staging client ID.
AO_CLOUD_STAGING_URL=
VITE_WORKOS_CLIENT_ID=

# Private Next.js Cloud UI. `npm run cloud:local` sets local values itself.
# `npm run cloud:web:staging` loads WorkOS server credentials from AWS Secrets
# Manager and sets every variable below without writing secrets to this file.
# Local state defaults to ~/.ao/cloud/postgres.
AO_DATA_DIR=
AO_CLOUD_LOCAL_POSTGRES_DATA_DIR=
AO_CLOUD_WEB_MODE=local
AO_CLOUD_WEB_API_BASE_URL=http://127.0.0.1:8081
# GitHub installs, OAuth callbacks, grants, and webhooks stay production-owned.
AO_CLOUD_GITHUB_API_BASE_URL=https://api.aoagents.dev
AO_CLOUD_WEB_PORT=3000
# AuthKit Next.js values. Local mode uses these only for the GitHub broker.
# Never prefix the API key or cookie
# password with NEXT_PUBLIC_.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
WORKOS_REDIRECT_URI=http://127.0.0.1:3000/callback
# AuthKit reads this non-secret public mirror when configuring cookies.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://127.0.0.1:3000/callback
AO_CLOUD_STAGING_WORKOS_SECRET_ID=ao-cloud/staging/workos
AO_CLOUD_WEB_STATE_DIR=

# Persistent duplex terminal streams (low-latency typing). Off by default;
# the polled store-and-forward transport is byte-identical when unset.
# AO_CLOUD_TERMINAL_STREAM=1
