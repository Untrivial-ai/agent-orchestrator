        "deterministic-contract"
      ],
      "providersByLane": {
        "packaged-electron-live-canary": [
          "claude-code"
        ],
        "deterministic-contract": [
          "scripted-chat-driver"
        ]
      },
      "interfaces": [
        "chat"
      ],
      "manualScenarioIds": [
        "S08",
        "S09"
      ],
