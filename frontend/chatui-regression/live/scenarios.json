      ],
      "actions": [
        {
          "id": "snapshot-before",
          "operation": "snapshot_filesystem_metadata",
          "arguments": {
            "scopes": [
              {
                "name": "fixture",
                "capture": "git-status-and-diff"
              },
              {
                "name": "dedicated-provider-profile",
                "capture": "allowlisted-metadata-only",
                "allowlistedGlobs": [
                  "plans/**"
                ],
                "fields": [
                  "relativePath",
                  "fileType",
                  "sizeBytes",
                  "modifiedAt",
                  "sha256"
                ],
                "includeFileContents": false,
                "includeProviderConfiguration": false
              }
            ],
            "label": "before-plan-mode"
          }
        },
        {
          "id": "create-chat-session",
          "operation": "create_session",
          "arguments": {
            "harness": "claude-code",
            "interface": "chat",
            "fixture": "todo-app"
          }
        },
        {
          "id": "select-plan-mode",
          "operation": "set_turn_setting",
          "arguments": {
            "setting": "permission-mode",
            "value": "plan"
          }
        },
        {
          "id": "send-no-write-prompt",
          "operation": "send_message",
          "arguments": {
            "text": "In exactly two numbered steps, propose how to add persistence to this todo app. Do not execute or modify files.",
            "delivery": "queue"
          }
        },
        {
          "id": "wait-for-settlement",
          "operation": "wait_for_turn",
          "arguments": {
            "state": "terminal",
            "resolveImplementationApproval": "deny"
          }
        },
        {
          "id": "snapshot-after",
          "operation": "snapshot_filesystem_metadata",
          "arguments": {
            "scopes": [
              {
                "name": "fixture",
                "capture": "git-status-and-diff"
              },
              {
                "name": "dedicated-provider-profile",
                "capture": "allowlisted-metadata-only",
                "allowlistedGlobs": [
                  "plans/**"
                ],
                "fields": [
                  "relativePath",
                  "fileType",
                  "sizeBytes",
                  "modifiedAt",
                  "sha256"
                ],
                "includeFileContents": false,
                "includeProviderConfiguration": false
              }
            ],
            "label": "after-plan-mode"
          }
        }
      ],
      "expectedResults": [
        {
          "id": "truthful-copy",
          "assertion": "turn_setting_copy_matches_observed_capability",
          "description": "AO must not promise no tool execution if the selected provider mode reads or writes a private plan artifact."
        },
        {
          "id": "no-undisclosed-write",
          "assertion": "no_undisclosed_filesystem_write",
          "description": "Any provider-private plan write is disclosed and remains inside the dedicated test profile; the source repository is untouched."
        },
        {
          "id": "fixture-protected",
          "assertion": "fixture_has_no_unrequested_change",
          "description": "The no-modification prompt leaves the todo fixture unchanged."
        }
      ],
      "evidence": [
        {
          "kind": "screenshot",
          "checkpoint": "plan-mode-description",
          "required": true
        },
        {
          "kind": "screenshot",
          "checkpoint": "settled-plan-timeline",
          "required": true
        },
        {
          "kind": "redacted-filesystem-metadata",
          "checkpoint": "before-after-fixture-and-allowlisted-plan-files",
          "scope": {
            "fixture": "git-status-and-diff",
            "providerProfile": "plans/** metadata only",
            "includeFileContents": false,
            "includeProviderConfiguration": false
          },
          "required": true
        },
        {
          "kind": "api-snapshot",
          "checkpoint": "conversation-after-settlement",
          "required": true
        }
      ]
    },
