{
	"name": "@agent-orchestrator/mobile",
	"version": "0.0.0",
	"private": true,
	"description": "Expo mobile supervisor for Agent Orchestrator",
	"main": "expo-router/entry",
	"scripts": {
		"start": "expo start",
		"start:perf": "expo start --dev-client --no-dev --minify",
		"android": "expo run:android",
		"ios": "expo run:ios",
		"typecheck": "tsc --noEmit",
		"build": "npm run typecheck",
		"postinstall": "patch-package",
		"test": "vitest run"
	},
	"dependencies": {
		"@expo/vector-icons": "^15.0.3",
		"@fressh/react-native-xtermjs-webview": "^0.0.8",
		"@react-native-async-storage/async-storage": "2.2.0",
		"expo": "~57.0.18",
		"expo-application": "~57.0.2",
		"expo-build-properties": "~57.0.13",
		"expo-camera": "~57.0.4",
		"expo-clipboard": "~57.0.1",
		"expo-constants": "~57.0.13",
		"expo-device": "~57.0.1",
		"expo-document-picker": "~57.0.1",
		"expo-file-system": "~57.0.5",
		"expo-font": "~57.0.1",
		"expo-haptics": "~57.0.1",
		"expo-image-picker": "~57.0.12",
		"expo-in-app-updates": "^0.12.0",
		"expo-linking": "~57.0.7",
		"expo-notifications": "~57.0.13",
		"expo-router": "~57.0.15",
		"expo-secure-store": "~57.0.1",
		"expo-speech-recognition": "^56.0.1",
		"expo-splash-screen": "~57.0.7",
		"expo-status-bar": "~57.0.1",
		"expo-updates": "~57.0.19",
		"posthog-react-native": "^4.62.0",
		"react": "19.2.3",
		"react-native": "0.86.3",
		"react-native-safe-area-context": "~5.7.0",
		"react-native-screens": "~4.26.0",
		"react-native-webview": "13.16.1"
	},
	"expo": {
		"autolinking": {
			"apple": {
				"exclude": ["expo-in-app-updates"]
			}
		}
	},
	"devDependencies": {
		"@types/node": "^26.2.0",
		"@types/react": "~19.2.4",
		"patch-package": "^8.0.1",
		"typescript": "~6.0.3",
		"vitest": "^4.1.10"
	}
}
