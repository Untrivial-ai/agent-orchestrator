{
	"expo": {
		"name": "AO",
		"slug": "ao-mobile",
		"version": "1.2.0",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "automatic",
		"backgroundColor": "#0a0b0d",
		"scheme": "aomobile",
		"splash": {
			"image": "./assets/splash-icon.png",
			"resizeMode": "contain",
			"backgroundColor": "#0a0b0d"
		},
		"ios": {
			"icon": "./assets/AO.icon",
			"supportsTablet": true,
			"bundleIdentifier": "aoagents.ao",
			"config": {
				"usesNonExemptEncryption": false
			},
			"infoPlist": {
				"NSLocalNetworkUsageDescription": "AO connects to Agent Orchestrator running on your computer over your local network.",
				"NSPhotoLibraryUsageDescription": "AO uses camera-related system features to help pair with your desktop.",
				"NSAppTransportSecurity": {
					"NSAllowsLocalNetworking": true
				},
				"LSApplicationQueriesSchemes": ["github"]
			}
		},
		"android": {
			"package": "aoagents.dev",
			"googleServicesFile": "./google-services.json",
			"adaptiveIcon": {
				"backgroundColor": "#0a0b0d",
				"foregroundImage": "./assets/android-icon-foreground.png",
				"monochromeImage": "./assets/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false,
			"permissions": ["android.permission.CAMERA"],
			"softwareKeyboardLayoutMode": "resize"
		},
		"web": {
			"favicon": "./assets/favicon.png",
			"bundler": "metro"
		},
		"plugins": [
			"expo-router",
			[
				"expo-build-properties",
				{
					"android": {
						"usesCleartextTraffic": true
					}
				}
			],
			[
				"expo-camera",
				{
					"cameraPermission": "Allow AO to scan the pairing QR code.",
					"recordAudioAndroid": false
				}
			],
			[
				"expo-image-picker",
				{
					"photosPermission": "Allow AO to attach images to agent conversations."
				}
			],
			"expo-document-picker",
			[
				"expo-speech-recognition",
				{
					"microphonePermission": "Allow AO to use the microphone so you can dictate prompts to an agent.",
					"speechRecognitionPermission": "Allow AO to transcribe your speech into prompts for an agent."
				}
			],
			[
				"expo-notifications",
				{
					"color": "#4d8dff"
				}
			],
			"expo-secure-store"
		],
		"extra": {
			"router": {},
			"eas": {
				"projectId": "2d7dec61-2206-4943-8582-a37e160907ea"
			}
		},
		"owner": "untrivial"
	}
}
