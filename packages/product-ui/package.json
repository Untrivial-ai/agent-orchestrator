{
	"name": "@aoagents/product-ui",
	"version": "0.1.0",
	"description": "Portable product presentation models, helpers, and leaf components for AO clients",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "vite build --config vite.build.config.ts && tsc -p tsconfig.build.json",
		"prepack": "npm run build",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.6.0"
	},
	"peerDependencies": {
		"motion": "^12.43.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^22.0.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"jsdom": "^29.1.1",
		"motion": "^12.43.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"typescript": "^5.6.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/aoagents/agent-orchestrator.git",
		"directory": "packages/product-ui"
	}
}
